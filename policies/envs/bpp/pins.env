# Pins for `scripts/install_policy_env.sh bpp`, which sources this file.
#
# Verified on 2026-09-11 on an RTX 5090 (driver 580.173.02, compute capability 12.0) in a
# container: the environment these pins build loaded the LIBERO-Gen Combination checkpoint with
# every key matched strictly and ran inference (docs/install.md, Model environments).
# shellcheck shell=bash disable=SC2034

PYTHON_VERSION=3.10

# The model repository, and the submodules BPP imports.
REPO_URL=https://github.com/real-stanford/behavior_prompting.git
REPO_COMMIT=ec29e62dde999ac3423df7d99a773c1dd28b480e
REPO_DIR=behavior_prompting
SUBMODULES=(deps/LIBERO deps/icrt)

# torch from the cu128 index, which ships sm_120 kernels; BPP's documented default,
# 2.7.1+cu118, has none.
TORCH_INDEX=https://download.pytorch.org/whl/cu128
TORCH=(torch==2.8.0 torchvision==0.23.0)

# LIBERO's simulator stack, for BPP's LIBERO runner and the dataset parity check.
LIBERO_STACK=(mujoco==3.3.0 robosuite==1.4.0 bddl==1.0.1)
# gym 0.21's setup.py fails under current build tools, so pip installs it with old ones.
LEGACY_BUILD_TOOLS=(pip==24.0 setuptools==65.5.0 wheel==0.38.4)
GYM=(gym==0.21.0)

# The robomimic fork BPP's LIBERO runner and utils/libero_util.py import: branch
# behavior_prompting_fixes, at the commit the verified install resolved it to. Its egl-probe
# dependency builds with cmake, and CMake 4 rejects egl-probe's old minimum version, hence
# CMAKE_POLICY_VERSION_MINIMUM=3.5 in the installer.
CMAKE=(cmake==4.4.3)
ROBOMIMIC=("robomimic @ git+https://github.com/austinapatel/robomimic.git@f4357ed548b656800636ee459c7a2f31f95b5a08")

# The vision backbone BPP's model builds with `pretrained=true`. The checkpoint overwrites its
# weights, but timm downloads them at construction, so the installer prefetches them into the
# Hugging Face cache and servers can run with HF_HUB_OFFLINE=1.
BACKBONE=vit_base_patch16_clip_224.openai

# What the smoke stage imports: BPP's policy class.
SMOKE_IMPORT=behavior_prompting.train_network.policy.diffusion_unet_policy
