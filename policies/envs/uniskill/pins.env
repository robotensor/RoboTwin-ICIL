# Pins for `scripts/install_policy_env.sh uniskill`, which sources this file.
#
# Built and verified on an RTX 5090 on 2026-09-11 (#43): torch 2.8.0+cu128 for sm_120,
# transformers 4.57.1 for Depth-Anything-V2, diffusers 0.35.1 (its EMAModel still takes the
# fork's model_cls), the UniSkill policy fork and the skill encoder, as the plan (A3, I4) has
# them; policies/tests/test_uniskill_env.py is its contract. The repositories and commits are
# the ones the plan was read against.
# shellcheck shell=bash disable=SC2034

PYTHON_VERSION=3.10

# The skill encoder (ISD, `dynamics/idm.py`): a script repository, put on the env's path.
ISD_URL=https://github.com/KimHanjung/UniSkill.git
ISD_COMMIT=eca49f032fb22200cb45d5e4055a87d306c3ba21
ISD_DIR=UniSkill

# The policy fork (robomimic with UniSkill's DiffusionPolicyUNet). Its submodules at this commit
# (LIBERO 8f1084e, robosuite c848ca8, robocasa 0eae063) are left out: only the fork's LIBERO
# training and evaluation scripts import them, never the adapter, and robocasa pins numpy 1.23.3.
POLICY_URL=https://github.com/kang-jaehyun/UniSkill-Policy.git
POLICY_COMMIT=2803ad6ebd367a20b425d7ee7a2cedd950056529
POLICY_DIR=UniSkill-Policy

TORCH_INDEX=https://download.pytorch.org/whl/cu128
TORCH=(torch==2.8.0 torchvision==0.23.0)

# What the smoke stage imports: the fork's algorithms, the skill encoder, and the libraries the
# plan moved. The environment contract test (policies/tests/test_uniskill_env.py) goes further.
SMOKE_IMPORTS=(robomimic.algo robomimic.config dynamics.idm diffusers.training_utils transformers)
